# ==============================================================================
# AI Assistant Server Configuration
# ==============================================================================

# Server Port (AI Studio runtime uses 3000)
PORT=3000
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# LLM Provider Fallback Chain (Strict order: openrouter -> gemini -> groq)
# ==============================================================================
PROVIDER_ORDER="openrouter,gemini,groq"
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

OPENROUTER_MODEL_FAST="openai/gpt-4o-mini"
OPENROUTER_MODEL_STRONG="openai/gpt-4o"
OPENROUTER_MODEL_VISION="openai/gpt-4o-mini"

GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_STRONG="gemini-2.5-pro"

GROQ_MODEL_FAST="llama-3.3-70b-versatile"
GROQ_MODEL_STRONG="llama-3.3-70b-versatile"

LLM_TIMEOUT_CONNECT_MS=3000
LLM_TIMEOUT_TTFT_MS=8000
LLM_TIMEOUT_TOTAL_MS=45000

# ==============================================================================
# Vector Store (Supabase pgvector primary, automatic in-memory fallback for dev)
# ==============================================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
VECTOR_STORE_MODE="auto"

# ==============================================================================
# Security, Auth & Limits
# ==============================================================================
JWT_SECRET="dev-change-this-secret-in-production"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_IP=60
RATE_LIMIT_MAX_USER=40
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=5000

# ==============================================================================
# Platform Super Admin Bootstrap (Platform owner credentials, used for initial setup)
# ==============================================================================
SUPER_ADMIN_EMAIL="superadmin@khaznacampus.platform"
SUPER_ADMIN_PASSWORD="ChangeMeToAStrongPassword123!"
RESPONSE_CACHE_TTL_MS=300000
CONFIRMATION_SECRET="dev-confirm-hmac-secret"
PROFILES_DIR="./profiles"
LOG_LEVEL="info"
